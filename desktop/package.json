{
  "name": "buddy-desktop",
  "productName": "Buddy",
  "version": "0.1.0",
  "description": "Buddy, a voice assistant you can talk to, as a Mac app",
  "author": "Bhargavi Thoka",
  "private": true,
  "main": "src/main.js",
  "scripts": {
    "start": "electron .",
    "build:frontend": "cd ../frontend && npm run build",
    "build:backend": "./scripts/build-backend.sh",
    "icon": "electron scripts/make-icon.js",
    "dist": "npm run build:frontend && npm run build:backend && electron-builder --mac dmg --arm64"
  },
  "devDependencies": {
    "electron": "45.2.3",
    "electron-builder": "26.18.1"
  },
  "build": {
    "appId": "com.bhargavithoka.buddy",
    "productName": "Buddy",
    "directories": {
      "output": "dist"
    },
    "files": [
      "src/**/*",
      "package.json"
    ],
    "extraResources": [
      {
        "from": "build/buddy-backend",
        "to": "backend"
      },
      {
        "from": "../frontend/dist",
        "to": "frontend"
      }
    ],
    "mac": {
      "category": "public.app-category.productivity",
      "icon": "assets/icon.png",
      "identity": null,
      "extendInfo": {
        "NSMicrophoneUsageDescription": "Buddy listens to you through the microphone so you can talk to him."
      }
    },
    "dmg": {
      "title": "Buddy"
    }
  }
}
