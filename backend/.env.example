# Copy this file to .env and fill in what you have.
# See the README (or the Settings screen in the app) for how to get the keys.

# Ollama (free, runs on your computer). Install it from ollama.com, then
#   ollama pull llama3.2:3b && ollama pull llama3.1:8b
OLLAMA_URL=http://localhost:11434
OLLAMA_FAST_MODEL=llama3.2:3b
OLLAMA_SMART_MODEL=llama3.1:8b

# Gemini (free tier, needs a free key from aistudio.google.com/apikey)
GEMINI_API_KEY=
GEMINI_FAST_MODEL=gemini-3.5-flash-lite
GEMINI_SMART_MODEL=gemini-3.8-flash

# Claude. Leave empty if you've run `ant auth login` or exported ANTHROPIC_API_KEY.
ANTHROPIC_API_KEY=

# ChatGPT. Also used for speech-to-text and Buddy's voice.
OPENAI_API_KEY=

# Models for the Fast / Smart switch (paid options)
CLAUDE_FAST_MODEL=claude-haiku-5-5
CLAUDE_SMART_MODEL=claude-opus-5-5
OPENAI_FAST_MODEL=your-gpt-5-luna-model-id
OPENAI_SMART_MODEL=your-sol-model-id

# Speech
TRANSCRIBE_MODEL=gpt-4o-mini-transcribe
TTS_MODEL=gpt-4o-mini-tts
TTS_VOICE=ash

# Set to true to try the app without any keys (fake replies and a beep voice)
DEMO_MODE=false
